---
const intro = "12 years of building operating systems. A few highlights:";

const stats = [
  "5 → 60 team scaled at a VC-backed startup after a $13.5M Series A",
  "$75M treasury deployed, $300M portfolio managed across 15+ countries",
  "2 × $20M health programs launched across Sub-Saharan Africa",
  "6 new markets opened across West Africa, Asia, and Australia",
  "Built 2 new revenue lines from scratch — an internal product incubator and a dev-services shop — to open new ARR and scale user growth",
];
---

<section class="section proof">
  <div class="wrap">
    <div class="section-heading">
      <span class="eyebrow">By the numbers</span>
      <h2>Proof</h2>
    </div>
    <p class="proof__intro">{intro}</p>
    <ul class="proof__list">
      {stats.map((stat) => <li>{stat}</li>)}
    </ul>
  </div>
</section>

<style>
  .proof__intro {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
    line-height: var(--lh-relaxed);
  }

  .proof__list {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .proof__list li {
    padding-left: 1.25em;
    position: relative;
    line-height: var(--lh-relaxed);
    color: var(--color-ink-soft);
  }

  .proof__list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>
