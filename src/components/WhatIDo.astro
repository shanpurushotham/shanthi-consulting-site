---
const services = [
  {
    title: "Operating systems setup",
    body: "OKRs, quarterly planning, the operating cadence that keeps leadership aligned, and the tools that actually fit your stage.",
  },
  {
    title: "Fundraising and investor readiness",
    body: "Support through raises ranging from a $500K seed to a $13.5M Series A, plus a $5M subsidiary raise, and time spent across the table during diligence.",
  },
  {
    title: "Impact, Analytics, and KPI tracking",
    body: "Real-time dashboards that give leadership visibility into performance, budget, and team health, even after you can no longer track it all yourself.",
  },
  {
    title: "Org design and hiring",
    body: "Who to hire, when, and how to avoid the expensive early mistakes.",
  },
  {
    title: "Culture and values",
    body: "Defining what you actually stand for, and developing the practices that strengthen culture with scale.",
  },
];
---

<section class="section what" id="what-i-do">
  <div class="wrap">
    <div class="section-heading">
      <span class="eyebrow">What I do</span>
      <h2>What I do</h2>
    </div>
    <div class="what__grid">
      {services.map((service) => (
        <div class="what__item">
          <h3>{service.title}</h3>
          <p>{service.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .what__grid {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-4);
  }

  .what__item:last-child {
    grid-column: 1 / -1;
    max-width: calc(50% - (var(--space-4) / 2));
    margin-inline: auto;
  }

  .what__item h3 {
    color: var(--color-ink);
  }

  .what__item p {
    margin-top: var(--space-1);
    color: var(--color-ink-soft);
    line-height: var(--lh-relaxed);
  }

  @media (max-width: 45rem) {
    .what__grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .what__item:last-child {
      max-width: none;
      margin-inline: 0;
    }
  }
</style>
